Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Any folder name works: /task-erp, /task-erp2, etc.

    # Static assets from /public
    RewriteRule ^(css|js|images|uploads)/(.*)$ public/$1/$2 [L]

    # Real files at project root
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # All app routes → front controller (keeps pretty URLs like /login)
    RewriteRule ^ public/index.php [L]
</IfModule>

<Files ".env">
    Require all denied
</Files>
